PACKAGE_NAME="dccp"
PACKAGE_VERSION="7.0.0"
MAKE[0]="cmake -B build && cmake --build build --target dccp_modules"
CLEAN="cmake --build build --target clean_modules"
BUILT_MODULE_NAME[0]="dccp"
BUILT_MODULE_LOCATION[0]="modules/net/dccp"
DEST_MODULE_LOCATION[0]="/extra"
BUILT_MODULE_NAME[1]="dccp_ipv4"
BUILT_MODULE_LOCATION[1]="modules/net/dccp"
DEST_MODULE_LOCATION[1]="/extra"
BUILT_MODULE_NAME[2]="dccp_ipv6"
BUILT_MODULE_LOCATION[2]="modules/net/dccp"
DEST_MODULE_LOCATION[2]="/extra"
BUILT_MODULE_NAME[3]="dccp_diag"
BUILT_MODULE_LOCATION[3]="modules/net/dccp"
DEST_MODULE_LOCATION[3]="/extra"
AUTOINSTALL="yes"
